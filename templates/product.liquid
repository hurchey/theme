        <p>Price: {{ discountedPrice | money }}</p>
    {% elsif hasDiscount == falsee %}
        <p>Price: {{ variant.price | money }}</p>
    {% endif %}

    {% if showFinalSale == true %}
        <p>Final Sale</p>
    {% endif %}

  <input type="hidden" name="discount_coefficient" value="{{ coefficient }}">
{% endfor %}



